ADMIN_DATABASE_URL=postgres://admin:test-password@localhost:5432/cargoflow_admin_test
INVENTORY_DATABASE_URL=postgres://admin:test-password@localhost:5432/cargoflow_inventory_test
BOOKING_DATABASE_URL=postgres://admin:test-password@localhost:5432/cargoflow_booking_test
PAYMENT_DATABASE_URL=postgres://admin:test-password@localhost:5432/cargoflow_payment_test

REDIS_URL=redis://:test-password@localhost:6379/15
ELASTICSEARCH_HUB_INDEX=cargoflow_hubs_test
ELASTICSEARCH_VEHICLE_INDEX=cargoflow_vehicles_test
KAFKA_CONSUMER_GROUP_SUFFIX=test
